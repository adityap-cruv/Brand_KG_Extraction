# Which engine to use as the LLM for the RAG pipeline.
#   claude -> shells out to `claude -p`  (Claude Max/Pro plan, no API key)
#   codex  -> shells out to `codex exec` (ChatGPT Pro/Plus plan, no API key)
#   local  -> OpenAI-compatible HTTP endpoint for a self-hosted model (no real key)
BRANDKG_ENGINE=claude

# Optional model overrides (leave unset to use each CLI's default)
# BRANDKG_CLAUDE_MODEL=claude-sonnet-4-6
# BRANDKG_CODEX_MODEL=gpt-5.5

# Local model settings (only used when BRANDKG_ENGINE=local).
# base_url must include the /v1 suffix; ngrok URLs rotate, so update as needed.
# BRANDKG_LOCAL_BASE_URL=https://d180-103-91-222-46.ngrok-free.app/v1
# BRANDKG_LOCAL_MODEL=qwen3.6:35b
# BRANDKG_LOCAL_API_KEY=ollama
# Reliability knobs for slow local reasoning models (sensible defaults are baked in):
# BRANDKG_LOCAL_MAX_TOKENS=16384   # big budget so hidden "thinking" can finish; too low => empty content
# BRANDKG_LOCAL_MIN_TIMEOUT=600    # per-call timeout floor (seconds); qwen3.6 is slow
# BRANDKG_LOCAL_JSON_MODE=1        # request response_format=json_object on extraction; 0 to disable

# Source documents to build the KG from (.docx/.pptx/.pdf/.md/.txt)
BRANDKG_SOURCE_DIR=/home/aditya/Documents/Ref Docs for Knowledge Graph/Ref Docs for Knowledge Graph

# Neo4j connection (docker-compose below maps these ports)
BRANDKG_NEO4J_URI=bolt://localhost:7688
BRANDKG_NEO4J_USER=neo4j
BRANDKG_NEO4J_PASSWORD=brandkg2026

# How many extraction subagents to run concurrently
BRANDKG_CONCURRENCY=6
